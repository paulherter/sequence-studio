<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Developer ID packages (scripts/package.sh): deliberately empty. Xcode's build injects
     com.apple.security.get-task-allow (debugging); notarization rejects it and Gatekeeper treats it as a dev build.
     Passing this file at re-sign time replaces the injected set. Not sandboxed; Speech runs on device. The microphone entitlement is for Record Voice-Over. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
