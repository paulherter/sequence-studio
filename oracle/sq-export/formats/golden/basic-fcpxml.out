<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.8">
    <resources>
        <format id="r1" frameDuration="1/25s" width="1920" height="1080"/>
        <asset id="r2" name="A001.mov" start="0s" duration="15s" hasVideo="1" hasAudio="1" format="r1" src="file:///Volumes/Shoot/A001.mov"/>
        <asset id="r3" name="B &amp; C.mov" start="0s" duration="4s" hasVideo="1" hasAudio="1" format="r1" src="file:///Volumes/Shoot/B%20&amp;%20C.mov"/>
    </resources>
    <library>
        <event name="Sequence Studio">
            <project name="Cut &amp; &quot;Co&quot;">
                <sequence format="r1" duration="7s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <asset-clip ref="r2" offset="0s" name="A001.mov" start="10s" duration="5s">
                            <audio ref="r3" lane="-2" offset="10s" name="B &amp; C.mov" start="0s" duration="1s"/>
                            <video ref="r3" lane="1" offset="52/5s" name="B &amp; C.mov" start="1s" duration="1s"/>
                            <marker start="11s" duration="1/25s" value="Beat" note="drum"/>
                            <marker start="12s" duration="4/5s" value="Range &lt;x&gt;" note="two"/>
                        </asset-clip>
                        <video ref="r3" offset="5s" name="Fast &amp; Loud" start="0s" duration="2s">
                            <timeMap>
                                <timept time="0s" value="0s" interp="linear"/>
                                <timept time="2s" value="4s" interp="linear"/>
                            </timeMap>
                        </video>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
