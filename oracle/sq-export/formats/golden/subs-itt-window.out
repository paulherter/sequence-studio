<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:timeBase="media" xml:lang="de">
<head>
<styling>
<style xml:id="s1" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:fontWeight="normal" tts:color="white" tts:textAlign="center"/>
</styling>
<layout>
<region xml:id="bottom" tts:origin="10% 80%" tts:extent="80% 20%" tts:displayAlign="after"/>
</layout>
</head>
<body>
<div>
<p begin="00:00:00.000" end="00:00:00.500" region="bottom" style="s1">First</p>
<p begin="00:00:01.000" end="00:00:05.500" region="bottom" style="s1">Second &amp; &lt;b&gt;<br/>line --&gt; two</p>
<p begin="00:00:08.500" end="00:00:09.000" region="bottom" style="s1">Same start A</p>
<p begin="00:00:08.500" end="00:00:09.000" region="bottom" style="s1">Same start B<br/>tail &gt; x</p>
</div>
</body>
</tt>
