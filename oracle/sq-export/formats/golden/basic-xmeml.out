<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xmeml>
<xmeml version="4">
  <sequence id="sequence-1">
    <name>Cut &amp; &quot;Co&quot;</name>
    <duration>175</duration>
    <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
    <timecode>
      <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
      <string>00:00:00:00</string><frame>0</frame><displayformat>NDF</displayformat>
    </timecode>
    <marker><name>Beat</name><comment>drum</comment><in>25</in><out>-1</out></marker>
    <marker><name>Range &lt;x&gt;</name><comment>two</comment><in>50</in><out>70</out></marker>
    <media>
      <video>
        <format><samplecharacteristics>
          <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
          <width>1920</width><height>1080</height><pixelaspectratio>square</pixelaspectratio>
        </samplecharacteristics></format>
        <track>
          <clipitem id="clipitem-1">
            <name>A001.mov</name>
            <enabled>TRUE</enabled>
            <duration>125</duration>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <start>0</start><end>125</end>
            <in>250</in><out>375</out>
            <file id="file-1">
              <name>A001.mov</name>
              <pathurl>file:///Volumes/Shoot/A001.mov</pathurl>
              <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
              <media>
                <video/>
              </media>
            </file>
            <link><linkclipref>clipitem-1</linkclipref><mediatype>video</mediatype><trackindex>1</trackindex><clipindex>1</clipindex></link>
            <link><linkclipref>clipitem-4</linkclipref><mediatype>audio</mediatype><trackindex>1</trackindex><clipindex>1</clipindex></link>
          </clipitem>
          <clipitem id="clipitem-2">
            <name>Fast &amp; Loud</name>
            <enabled>TRUE</enabled>
            <duration>50</duration>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <start>125</start><end>175</end>
            <in>0</in><out>100</out>
            <file id="file-2">
              <name>B &amp; C.mov</name>
              <pathurl>file:///Volumes/Shoot/B%20&amp;%20C.mov</pathurl>
              <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
              <media>
                <video/>
              </media>
            </file>
            <filter><effect><name>Time Remap</name><effectid>timeremap</effectid><effectcategory>motion</effectcategory><effecttype>motion</effecttype><mediatype>video</mediatype>
              <parameter><parameterid>speed</parameterid><name>speed</name><value>200</value></parameter>
            </effect></filter>
          </clipitem>
        </track>
        <track>
          <clipitem id="clipitem-3">
            <name>B &amp; C.mov</name>
            <enabled>TRUE</enabled>
            <duration>25</duration>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <start>10</start><end>35</end>
            <in>25</in><out>50</out>
            <file id="file-2"/>
          </clipitem>
        </track>
      </video>
      <audio>
        <numOutputChannels>2</numOutputChannels>
        <format><samplecharacteristics><depth>16</depth><samplerate>48000</samplerate></samplecharacteristics></format>
        <track>
          <clipitem id="clipitem-4">
            <name>A001.mov</name>
            <enabled>TRUE</enabled>
            <duration>125</duration>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <start>0</start><end>125</end>
            <in>250</in><out>375</out>
            <file id="file-1"/>
            <sourcetrack><mediatype>audio</mediatype><trackindex>1</trackindex></sourcetrack>
            <link><linkclipref>clipitem-1</linkclipref><mediatype>video</mediatype><trackindex>1</trackindex><clipindex>1</clipindex></link>
            <link><linkclipref>clipitem-4</linkclipref><mediatype>audio</mediatype><trackindex>1</trackindex><clipindex>1</clipindex></link>
          </clipitem>
        </track>
        <track>
          <clipitem id="clipitem-5">
            <name>B &amp; C.mov</name>
            <enabled>TRUE</enabled>
            <duration>25</duration>
            <rate><timebase>25</timebase><ntsc>FALSE</ntsc></rate>
            <start>0</start><end>25</end>
            <in>0</in><out>25</out>
            <file id="file-2"/>
            <sourcetrack><mediatype>audio</mediatype><trackindex>1</trackindex></sourcetrack>
          </clipitem>
        </track>
      </audio>
    </media>
  </sequence>
</xmeml>
