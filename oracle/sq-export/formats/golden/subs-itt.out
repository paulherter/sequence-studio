<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:timeBase="media" xml:lang="en-US&amp;&lt;"&gt;">
<head>
<styling>
<style xml:id="s1" tts:fontFamily="sansSerif" tts:fontSize="100%" tts:fontWeight="normal" tts:color="white" tts:textAlign="center"/>
</styling>
<layout>
<region xml:id="bottom" tts:origin="10% 80%" tts:extent="80% 20%" tts:displayAlign="after"/>
</layout>
</head>
<body>
<div>
<p begin="00:00:00.001" end="00:00:00.501" region="bottom" style="s1">Half ms</p>
<p begin="00:00:00.333" end="00:00:02.000" region="bottom" style="s1">First</p>
<p begin="00:00:02.500" end="00:00:07.000" region="bottom" style="s1">Second &amp; &lt;b&gt;<br/>line --&gt; two</p>
<p begin="00:00:10.000" end="00:00:11.000" region="bottom" style="s1">Same start A</p>
<p begin="00:00:10.000" end="00:00:12.000" region="bottom" style="s1">Same start B<br/>tail &gt; x</p>
<p begin="00:00:20.000" end="00:00:20.001" region="bottom" style="s1">Tiny</p>
<p begin="01:01:01.001" end="01:01:05.000" region="bottom" style="s1">Late</p>
</div>
</body>
</tt>
