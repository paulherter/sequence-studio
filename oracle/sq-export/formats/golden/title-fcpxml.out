<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.8">
    <resources>
        <format id="r1" frameDuration="1/25s" width="1920" height="1080"/>
        <asset id="r2" name="A001.mov" start="0s" duration="2s" hasVideo="1" hasAudio="0" format="r1" src="file:///Volumes/Shoot/A001.mov"/>
        <effect id="r3" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
    </resources>
    <library>
        <event name="Sequence Studio">
            <project name="Titles">
                <sequence format="r1" duration="3s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <video ref="r2" offset="0s" name="A001.mov" start="0s" duration="2s">
                            <title ref="r3" lane="1" offset="2/5s" name="Lower &amp; Third" start="0s" duration="4/5s">
                                <text><text-style ref="ts1">Over</text-style></text>
                                <text-style-def id="ts1"><text-style font="Helvetica Neue" fontSize="36.50" fontColor="1 0.5 0.333333 1" italic="1" alignment="left"/></text-style-def>
                            </title>
                        </video>
                        <title ref="r3" offset="2s" name="Lower &amp; Third" start="0s" duration="1s">
                            <text><text-style ref="ts2">Hello&#10;World &lt;3 &amp; &quot;q&quot;CRLF</text-style></text>
                            <text-style-def id="ts2"><text-style font="Helvetica Neue" fontSize="72" fontColor="1 0.5 0.333333 1" bold="1" alignment="center"/></text-style-def>
                        </title>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
